# =============================================================================
# datahub-service 环境变量示例
# 复制此文件为 .env 并填写真实配置
# =============================================================================

# --- 服务基础配置 ---
PROJECT_NAME=Datahub Service
ENVIRONMENT=development          # development | production

# --- 数据库 ---
# asyncpg 驱动，URL 格式：postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://nexus_admin:changeme@localhost:5432/nexuskit_datahub
DEBUG=false

# --- 存储配置 ---
# 统一使用 S3 协议，所有域共享同一套主账号凭证
# 域配置（Endpoint/Region）通过 API 管理，存储在数据库 s3_domains 表中
#
# S3 主账号凭证（所有域共享）
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-access-key-secret
#
# 域管理：
#   - 通过 POST /api/v1/s3-domains 创建域配置
#   - 示例：{"domain_name": "hangzhou", "endpoint_url": "https://oss-cn-hangzhou.aliyuncs.com", "region_name": "oss-cn-hangzhou", "is_default": true}
#
# Bucket 管理： 
#   - 通过 POST /api/v1/oss-configs 创建 Bucket 配置
#   - 示例：{"app_code": "diagnosis", "domain_name": "hangzhou", "config_name": "诊断平台", "bucket_name": "bucket-diagnosis", "is_default": true}

# --- NexusKit 服务间鉴权 ---
# 此服务向 NexusKit 发起内部调用时使用
NEXUSKIT_URL=http://nexuskit-service:5000
NEXUSKIT_APP_CODE=datahub
NEXUSKIT_APP_SECRET=jKZV6Wnop5GTYo_xn7qsvODwygqnHrkzSSxHv-CssEw  #测试秘钥忽略
# 内部密钥（必须与 gateway/core-service 中的 INTERNAL_SECRET 一致，用于生成 X-Gateway-Token）
INTERNAL_SECRET=change_me_internal_secret
